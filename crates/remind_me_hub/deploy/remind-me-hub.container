# Podman Quadlet — remind-me sync hub on the embedded engine: one container, a
# data directory on a local volume, no database server. Reachable via the
# host's Tailscale IP; update the PublishPort IP below if that address changes
# (setup.sh keeps an installed unit's address across reinstalls).
# Install to ~/.config/containers/systemd/remind-me-hub.container
# Secrets live in ~/remind-me-hub/hub.env (see hub.env.example).
[Unit]
Description=Remind Me Sync Hub
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=remind-me-hub
Image=localhost/remind-me-hub:latest
PublishPort=100.83.168.90:8765:8765
EnvironmentFile=%h/remind-me-hub/hub.env
# The image runs as uid 10001. `:U` tells Podman to chown the host directory
# to the container user, which is what makes a rootless bind mount writable
# here -- without it the hub cannot create its data and exits.
Volume=%h/remind-me-hub/data:/data:Z,U
# No Network= line: the hub reaches nothing else, so it needs no shared
# network.

[Service]
Restart=always

[Install]
WantedBy=default.target
