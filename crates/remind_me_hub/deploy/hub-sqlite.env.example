# Copy to ~/remind-me-hub/hub.env and fill in a real secret (chmod 600).
#
# The SQLite backend, which the Python hub has no equivalent for: one file, no
# database server, no second container. Suited to a single-operator hub; a
# busy one with many nodes pushing concurrently wants Postgres, since SQLite
# serialises writers.
#
# Set exactly one of REMIND_ME_HUB_DB_PATH and DATABASE_URL. Setting both is a
# startup error rather than a silent precedence rule -- it should never be
# ambiguous which store is serving.
REMIND_ME_HUB_DB_PATH=/data/hub.db

# Shared bearer token — must match REMIND_ME_SYNC_SECRET on every client.
SYNC_SECRET=change-me

#REMIND_ME_HUB_METRICS_ENABLED=1
