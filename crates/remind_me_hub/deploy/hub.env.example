# Copy to ~/remind-me-hub/hub.env and fill in a real secret (chmod 600).
#
# The embedded engine's data directory on the volume (docs/adr/0021). It is
# created on first start and locked while the hub runs, so a second hub
# pointed at it refuses to start.
#
# DATABASE_URL and REMIND_ME_HUB_DB_PATH configured the Postgres and SQLite
# stores, which are gone. The hub refuses to start with either set, so an old
# hub's data is never silently left behind; copy it onto the engine first
# (setup.sh migrate, or rusty-remind-me-hub-copy).
REMIND_ME_HUB_DATA_DIR=/data/hub

# Shared bearer token — must match REMIND_ME_SYNC_SECRET on every client.
# A hub with this unset refuses to start, and an empty value rejects every
# request rather than accepting an empty bearer.
SYNC_SECRET=change-me

# Optional. Defaults shown.
#REMIND_ME_HUB_COMPACT_INTERVAL_SECS=3600
#REMIND_ME_HUB_METRICS_ENABLED=1
#REMIND_ME_HUB_TOMBSTONE_RETENTION_DAYS=90
