# Copy to ~/remind-me-hub/hub.env and fill in a real secret (chmod 600).
#
# The embedded engine, the default store for a new hub (docs/adr/0021): a data
# directory on the volume, no database server. The directory is created on
# first start and locked while the hub runs, so a second hub pointed at it
# refuses to start.
#
# Set exactly one of REMIND_ME_HUB_DATA_DIR, REMIND_ME_HUB_DB_PATH and
# DATABASE_URL. More than one is a startup error rather than a silent
# precedence rule -- it should never be ambiguous which store is serving.
REMIND_ME_HUB_DATA_DIR=/data/hub

# Shared bearer token — must match REMIND_ME_SYNC_SECRET on every client.
SYNC_SECRET=change-me

# Optional. Defaults shown.
#REMIND_ME_HUB_COMPACT_INTERVAL_SECS=3600
#REMIND_ME_HUB_METRICS_ENABLED=1
#REMIND_ME_HUB_TOMBSTONE_RETENTION_DAYS=90
