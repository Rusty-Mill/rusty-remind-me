# Container image for the remind-me sync hub.
#
# Build from the **monorepo root** (the directory holding the workspace
# `Cargo.toml` and `Cargo.lock`), not this directory and not
# `crates/apps/rusty_remind_me`:
#
#     podman build -f crates/apps/rusty_remind_me/crates/remind_me_hub/Containerfile \
#                  -t remind-me-hub .
#
# `setup.sh` and every deploy template pass that context. The hub is one crate
# in a workspace of several hundred, so cargo needs the workspace manifest and
# lockfile, and every member's manifest, to resolve it. The root
# `.dockerignore` keeps `target/` and `.git` out of the context.

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM docker.io/library/rust:1-slim-bookworm AS build

# `rusqlite`'s bundled SQLite compiles C. The runtime stage below needs none of
# this, which is the point of splitting them.
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Cache mounts keep the registry and the build directory between builds, so
# an update recompiles only what changed. (This replaces the stub-manifest
# trick the standalone repo used, which cannot scale to a workspace of this
# size.) Both binaries: the hub, and the copy tool that moves an existing
# hub's data onto the embedded engine. They are copied out of the cache mount,
# which does not survive into the next stage by itself.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p remind_me_hub --bins \
    && mkdir -p /out \
    && cp target/release/rusty-remind-me-hub target/release/rusty-remind-me-hub-copy /out/ \
    && strip /out/rusty-remind-me-hub /out/rusty-remind-me-hub-copy

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# No Rust toolchain, no C compiler, no package manager for an attacker to
# reach. The binary statically links SQLite; `ca-certificates` is here for
# TLS to a managed Postgres, which several of the deploy templates use.
FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Kept in step with HUB_VERSION in src/lib.rs — setup.sh reads the constant out
# of the source and passes it here, so the two cannot disagree for an image
# built the documented way. The default is deliberately "unknown" rather than a
# number: a hand-built image that skipped the build-arg should say it doesn't
# know, not claim a version it may not be running.
ARG HUB_VERSION=unknown

# Non-root. The reference's image runs as root because the Python base image
# does; there is no reason to inherit that here, and a hub with a local store
# (the engine or SQLite) writes to a volume that should not be root-owned.
RUN useradd --system --create-home --uid 10001 hub \
    && mkdir /data && chown hub:hub /data
# /data exists, owned by `hub`, so a named volume mounted there (the compose
# files) starts out writable: Docker copies an image path's ownership into a
# new named volume only when the path exists in the image. Without it the
# volume is root-owned and the hub cannot create its store. (Podman Quadlets
# bind-mount with `:U` instead, which chowns the host directory.)
USER hub
WORKDIR /home/hub

# The copy tool ships in the image so a container deployment can move its
# SQLite or Postgres data onto the engine without a Rust toolchain
# (docs/adr/0021; the crate README's "Moving a hub onto the engine").
COPY --from=build /out/rusty-remind-me-hub /out/rusty-remind-me-hub-copy /usr/local/bin/

# The running hub reports its version over HTTP, which is no help when the
# container is stopped or crash-looping -- exactly when you most need to know
# which build you have. These make `podman inspect` answer it too.
LABEL org.opencontainers.image.title="remind-me sync hub (Rust)" \
      org.opencontainers.image.description="Central sync point for the remind_me distributed sync engine" \
      org.opencontainers.image.source="https://github.com/Rusty-Mill/rusty_mill" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${HUB_VERSION}"

# 0.0.0.0 inside the container, published to a loopback or private address by
# the deploy templates. The binary's own default is 127.0.0.1, which is right
# for a bare process and wrong for a container, where it would be unreachable
# even from the host.
ENV REMIND_ME_HUB_BIND=0.0.0.0 \
    REMIND_ME_HUB_PORT=8765

EXPOSE 8765

CMD ["rusty-remind-me-hub"]
