# Cargo build artifacts
/target/
**/*.rs.bk

# Local SQLite databases (created at runtime; never a source artifact)
*.db
*.db-wal
*.db-shm
# ...except the checked-in legacy stores the first-open copy is tested against
!crates/remind_me_core/tests/fixtures/legacy_store/*.db

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only debug scratch (not part of this repo's project)
/.profile-check.ps1
/rc/flatbuffers/

# Claude Code agent worktree bookkeeping (not part of this repo's project)
/.claude/worktrees/

# The cloud capture plugin is filled in locally and uploaded privately: never commit its token
/plugins/cloud-capture/config.json
__pycache__/
